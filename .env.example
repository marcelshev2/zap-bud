# ─── REQUIRED ────────────────────────────────────────────
# Anthropic Claude (the brain / suggestions)
# Create account + key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER

# ─── TRANSCRIPTION — pick ONE ────────────────────────────
# Option A (recommended to start): Groq — FREE, no credit card
# Create free account + key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_PLACEHOLDER

# Option B: OpenAI Whisper — paid (~$0.006/min), most reliable
# Only needed if you switch away from Groq later
# OPENAI_API_KEY=sk-PLACEHOLDER

# ─── MODELS (leave as-is unless you know what you're doing)
CLAUDE_MODEL=claude-haiku-4-5-20251001
# WHISPER_MODEL is auto-set based on which key you use above

# Reaction emoji that adds a message to the contact's memory pool
TRIGGER_EMOJI=🤖

# How many reacted messages to keep per contact
POOL_SIZE_PER_CONTACT=15

# Default language for suggestions (model still adapts to thread)
DEFAULT_LANGUAGE=pt-BR

# Local paths
DB_PATH=./data/zap-bud.db
AUTH_DIR=./auth
TMP_DIR=./tmp

# Stateful session timeout in self-chat (minutes) — after this, active contact resets
SESSION_TIMEOUT_MINUTES=30

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
