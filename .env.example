# ─── TO START FREE: only fill in GROQ_API_KEY ────────────
# Groq handles both transcription (Whisper) AND the brain (Llama 3.3 70B).
# Free account, no credit card: https://console.groq.com/keys
GROQ_API_KEY=gsk_PLACEHOLDER

# ─── TO UPGRADE THE BRAIN: add Anthropic ─────────────────
# Better tone matching in PT-BR. ~$5 lasts months of personal use.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER

# ─── ALTERNATIVE TRANSCRIPTION: OpenAI Whisper ───────────
# Only if you want to replace Groq for transcription. Paid (~$0.006/min).
# OPENAI_API_KEY=sk-PLACEHOLDER

# ─── MODELS (auto-set, leave commented unless you want to override)
# Default brain on Groq: meta-llama/llama-4-scout-17b-16e-instruct
#   (30K TPM, 500K TPD on free tier — best limits among quality models)
# Alternatives if PT-BR feels off: openai/gpt-oss-120b, qwen/qwen3-32b
# CLAUDE_MODEL=
#
# Default transcription on Groq: whisper-large-v3-turbo
# WHISPER_MODEL=

# Reaction emoji that adds a message to the contact's memory pool
TRIGGER_EMOJI=🤖

# How many reacted messages to keep per contact
POOL_SIZE_PER_CONTACT=15

# Default language for suggestions (model still adapts to thread)
DEFAULT_LANGUAGE=pt-BR

# Local paths
DB_PATH=./data/zap-bud.db
AUTH_DIR=./auth
TMP_DIR=./tmp

# Stateful session timeout in self-chat (minutes) — after this, active contact resets
SESSION_TIMEOUT_MINUTES=30

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
